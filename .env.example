# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer .env. Il ne sert qu'au développement et aux tests : l'API l'ignore en production.

# Base de données (ADR 0018) : sans DATABASE_URL, l'API utilise PGlite (PostgreSQL embarqué, sans Docker), dans le
# dossier BASE_LOCALE (.donnees/pglite par défaut), ou en mémoire avec BASE_LOCALE=memory://.
# BASE_LOCALE=.donnees/pglite
# Pour un vrai PostgreSQL (voir docker-compose.yml, port 5433) :
# DATABASE_URL=postgres://hipmaster:hipmaster@localhost:5433/hipmaster
# Avec sslmode=require (URL de Neon), le certificat du serveur est vérifié (ADR 0023).

# Pool PostgreSQL (ADR 0023) : connexions au plus, fermeture d'une connexion inactive et délai de connexion, en
# secondes. Une connexion ouverte empêche la base Neon de se mettre en veille.
# BASE_CONNEXIONS_MAX=5
# BASE_INACTIVITE_SECONDES=30
# BASE_DELAI_CONNEXION_SECONDES=10

# Journaux de l'API (lignes JSON au format de Cloud Logging) : fatal, error, warn, info, debug, trace ou silent.
# LOG_LEVEL=info

# Protections de l'API (ADR 0025). Hors production, les limites de débit sont désactivées et une clé publique protège
# les codes de récupération.
# LIMITES_DEBIT : facteur appliqué aux limites de production (2 les double), ou desactivees ; 1 en production.
# LIMITES_DEBIT=1
# CLE_CODES_RECUPERATION : 32 caractères au moins. Changer de clé invalide tous les codes de récupération.
# CLE_CODES_RECUPERATION=
# PROXYS_DE_CONFIANCE : relais devant l'API qui ajoutent leur maillon à X-Forwarded-For (0 : l'adresse de la connexion).
# PROXYS_DE_CONFIANCE=0

# API Fastify (le front Angular relaie /api vers cette adresse, voir apps/web/proxy.conf.json)
API_HOST=127.0.0.1
API_PORT=3000

# En production (image Docker sur Cloud Run, ADR 0021), ces variables viennent du service, jamais de ce fichier :
# - NODE_ENV=production : DATABASE_URL obligatoire (Secret Manager), pas de migration au démarrage (ADR 0023) ;
# - PORT, fourni par Cloud Run : l'API écoute alors 0.0.0.0:$PORT (API_HOST et API_PORT priment s'ils sont posés) ;
# - GOOGLE_CLOUD_PROJECT : identifiant du projet, pour relier chaque journal à la trace de sa requête ;
# - CLE_CODES_RECUPERATION (Secret Manager, secret cle-codes-recuperation) et PROXYS_DE_CONFIANCE=2 (Firebase Hosting,
#   puis le frontal de Cloud Run) : sans eux, l'API refuse de démarrer.
