# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer .env.

# Base PostgreSQL locale (voir docker-compose.yml, port 5433 pour ne pas gêner un Postgres déjà installé)
DATABASE_URL=postgres://hipmaster:hipmaster@localhost:5433/hipmaster

# API Fastify (le front Angular relaie /api vers cette adresse, voir apps/web/proxy.conf.json)
API_HOST=127.0.0.1
API_PORT=3000
