{
  "name": "@hipmaster/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de HIPMaster (Fastify, ADR 0007).",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=drizzle --watch-path=../../packages/domain/src src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrer.ts",
    "db:studio": "drizzle-kit studio",
    "invitation": "node src/invitation.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@hipmaster/domain": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-kit": "^0.31.11"
  }
}
