{
  "name": "hipmaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @hipmaster/api\" \"npm start -w @hipmaster/web\"",
    "build": "npm run build -w @hipmaster/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm test -w @hipmaster/web --if-present",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "simuler": "node scripts/simuler.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @hipmaster/api",
    "db:migrate": "npm run db:migrate -w @hipmaster/api",
    "db:studio": "npm run db:studio -w @hipmaster/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15"
  },
  "type": "module",
  "lint-staged": {
    "*.{json,md,yml,yaml,css,html}": "prettier --write",
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
